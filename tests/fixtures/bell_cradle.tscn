script = ExtResource("2")
level_id = "bell_cradle"
title = "The bell cradle"
question = "Where can you wait while the cradle changes?"
explanation = "Ride the outer arm to the fixed belfry, then leave it. Turn the empty cradle again so its underside arm meets the curved stair. Remaining aboard carries you away from the transfer."
overview_focus = Vector3(1, 0, -2)
overview_size = 34
hints = PackedStringArray("Find the ground that stays still.", "The curved belfry changes your ground without carrying you away.", "Ride one turn, step onto the belfry, turn the empty cradle again, then follow the curve to the lower arm.")

