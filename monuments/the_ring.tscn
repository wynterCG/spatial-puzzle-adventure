[node name="Level" type="Node3D" parent="."]
script = ExtResource("2")
level_id = "the_ring"
title = "The ring"
question = "Which side of the bridge needs to carry you?"
explanation = "The far balcony meets only the underside of the turning bridge, and the terrace sits above it. Ride the bridge to the curved stair, follow the stair under and back onto the same bridge, then turn it again while you hang beneath it."
overview_focus = Vector3(1, 0.5, -1)
overview_size = 36.0
hints = PackedStringArray("Compare which side of the bridge reaches the far balcony.", "The curved stair does not lead anywhere new. It leads under.", "Board, turn the bridge to the stair, follow the stair onto the bridge's underside, then turn the bridge to the balcony.")

