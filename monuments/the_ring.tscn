[node name="Level" type="Node3D" parent="."]
script = ExtResource("2")
level_id = "the_ring"
revision = 4
sweep_tolerance = 0.16
title = "The ring"
question = "What do you see from inside the tower?"
explanation = "The way out is underneath. Line up the inner wheel's top arm behind the ring arm and walk into the tower: its floor curls you underneath to the lower door. From inside, turn the inner wheel until its underside arm reaches you, walk out beneath it onto the underside of the ring arm you came in on, and ride the ring around to the balcony."
overview_focus = Vector3(4, 2, 0)
overview_size = 144
overview_azimuth_degrees = -45
overview_elevation_degrees = 43.31
hints = PackedStringArray("Look through the narrow slot in the tower when you are inside it.", "The tower opens on one side only. Something must line up with its upper door before you can enter.", "Turn the inner wheel so its top arm meets the ring arm, enter the tower, turn the inner wheel again from inside, step out underneath, and ride the ring to the balcony.")

