[node name="Level" type="Node3D" parent="."]
script = ExtResource("2")
level_id = "the_threshold"
revision = 1
title = "The threshold"
question = "From where can you see into the tower?"
explanation = "The tower has no door, and the shell around it turns. Ride the ledge one turn: the sleeve's low window lines up with the core's low slit, and from the ledge door you see a doorway hanging inside. Link to it and cross. Inside, curl over the slab's edge onto its top, then turn the sleeve twice: the high opening lines up with the high slit and shows the balcony door."
overview_focus = Vector3(-8, 12, 0)
overview_size = 152
overview_azimuth_degrees = -50
overview_elevation_degrees = 38
sweep_tolerance = 0.16
discovery_range = 160
hints = PackedStringArray("The outer shell turns; the tower inside it does not. What can you see through its openings, and from where?", "Stand at the ledge door and ride the sleeve one turn: the window and the low slit line up.", "Link the ledge door to the door inside and cross. Curl onto the slab top, turn the sleeve twice, link the high door to the balcony door and cross.")

