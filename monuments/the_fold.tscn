[node name="Level" type="Node3D" parent="."]
script = ExtResource("2")
level_id = "the_fold"
revision = 1
title = "The fold"
question = "Which doorway should you join before you turn the frame?"
explanation = "Join the entry doorway to the doorway on the frame while you can still see it, then turn the frame: the doorway goes with it, and the same link now opens onto a deck that has become a wall. From there the fixed slot shows the last doorway; join it to the frame's doorway and walk through."
overview_focus = Vector3(12, 0, -4)
overview_size = 160
overview_azimuth_degrees = -50
overview_elevation_degrees = 40
sweep_tolerance = 0.16
discovery_range = 160
hints = PackedStringArray("A link stays with the architecture that holds its doorway.", "Join A to B first. Turning the frame afterwards carries B, and the link, with it.", "Link A to B, turn the frame once, walk through A, look back out through B and the slot, link B to C, cross.")

