[node name="Level" type="Node3D" parent="."]
script = ExtResource("2")
level_id = "the_spillway"
revision = 1
title = "The spillway"
question = "How do you get under the reservoir?"
explanation = "Stand on the sluice drum and roll it over: it carries you underneath the keeper's landing, where the weir arm's underside meets you if it was swung west. Ride the arm north hanging beneath it, wrap round the north gallery onto its top, board the same arm from above and swing it west again: now the crown's keeper's gate stands over the throat stair. Walk down inside the spillway and out under the basin to the sanctuary."
overview_focus = Vector3(-8, -28, 0)
overview_size = 160
overview_azimuth_degrees = -52
overview_elevation_degrees = 32
sweep_tolerance = 0.16
hints = PackedStringArray("Lamps stand on any surface you can walk, even upside down. Which undersides have lamps?", "The drum is a gate that rolls. Stand on its deck when you roll it.", "Swing the arm west, roll yourself under the landing, ride the arm north beneath it, wrap onto the north gallery, board the arm on top and swing it west again: then take the keeper's gate down the throat.")

